---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Motion from '../components/Motion.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  transparentHeader?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  transparentHeader = false,
} = Astro.props;

const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={pageTitle} description={description} />
    <!-- Navegación con View Transitions: el cambio de página se funde
         en lugar de parpadear en blanco. -->
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>

    <Header transparent={transparentHeader} />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <!-- Cursor, barra de progreso y motor de animación -->
    <Motion />
  </body>
</html>
