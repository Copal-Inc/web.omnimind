---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
  title,
  description,
  publishDate,
  pubDate,
  updatedDate,
  heroImage,
  author,
  category,
  tags = [],
  cover,
  coverAlt,
  draft,
  featured,
} = Astro.props;

const displayDate = publishDate || pubDate;
---

<BaseLayout title={title} description={description}>

  <article aria-label={title}>

    <!-- PORTADA -->
    {(heroImage || cover) && (
      <div class="post-cover">
        {heroImage
          ? <Image class="post-cover__img" width={1200} height={600} src={heroImage} alt={coverAlt || title} />
          : <img class="post-cover__img" src={cover} alt={coverAlt || title} width="1200" height="600" />
        }
      </div>
    )}

    <!-- CABECERA DEL ARTÍCULO -->
    <header class="post-header section-muted">
      <div class="container-sm post-header__inner">
        <!-- Breadcrumb -->
        <nav aria-label="Breadcrumb" class="post-breadcrumb">
          <a href="/blog/">← Blog</a>
        </nav>

        <!-- Metadatos -->
        <div class="post-meta">
          {category && <span class="post-meta__category">{category}</span>}
          {featured && <span class="post-meta__featured">★ Destacado</span>}
          {draft && <span class="post-meta__draft">Borrador</span>}
        </div>

        <h1 class="post-header__title">{title}</h1>

        <div class="post-header__sub">
          {displayDate && (
            <time datetime={displayDate.toISOString()}>
              <FormattedDate date={displayDate} />
            </time>
          )}
          {author && <span class="post-header__author">· Por {author}</span>}
          {updatedDate && (
            <span class="post-header__updated">
              (actualizado: <FormattedDate date={updatedDate} />)
            </span>
          )}
        </div>

        {tags.length > 0 && (
          <ul class="post-tags" role="list" aria-label="Etiquetas del artículo">
            {tags.map((tag: string) => <li class="post-tags__tag">#{tag}</li>)}
          </ul>
        )}
      </div>
    </header>

    <!-- CONTENIDO -->
    <div class="section">
      <div class="container-sm prose">
        <slot />
      </div>
    </div>

    <!-- PIE DEL ARTÍCULO -->
    <footer class="post-footer section-muted">
      <div class="container-sm post-footer__inner">
        <a href="/blog/" class="btn btn-outline-dark">← Volver al blog</a>
        <a href="/contacto/" class="btn btn-primary">Solicitar cotización</a>
      </div>
    </footer>

  </article>

</BaseLayout>

<style>
  /* ── COVER ── */
  .post-cover {
    width: 100%;
    max-height: 480px;
    overflow: hidden;
    background: var(--color-surface-muted);
  }

  .post-cover__img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  /* ── HEADER ── */
  .post-header {
    padding-block: 3rem 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-header__inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .post-breadcrumb {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .post-breadcrumb a {
    color: var(--color-brand-primary);
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .post-meta__category {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-dark);
  }

  .post-meta__featured {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    background: #f59e0b;
    color: #fff;
    padding: 0.15em 0.5em;
    border-radius: var(--radius-pill);
  }

  .post-meta__draft {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    background: #ef4444;
    color: #fff;
    padding: 0.15em 0.5em;
    border-radius: var(--radius-pill);
  }

  .post-header__title {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    line-height: 1.15;
    margin: 0;
  }

  .post-header__sub {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    flex-wrap: wrap;
  }

  .post-header__updated { font-style: italic; }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-tags__tag {
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 0.2em 0.6em;
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
  }

  /* ── FOOTER ── */
  .post-footer {
    border-top: 1px solid var(--color-border);
    padding-block: 2.5rem;
  }

  .post-footer__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
