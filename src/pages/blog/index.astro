---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => {
    const dateA = a.data.publishDate || a.data.pubDate || new Date(0);
    const dateB = b.data.publishDate || b.data.pubDate || new Date(0);
    return dateB.valueOf() - dateA.valueOf();
  });
---

<BaseLayout
  title="Blog"
  description="Artículos, recursos y reflexiones sobre productividad, bienestar organizacional y neurociencias aplicadas al trabajo. Contenido basado en evidencia del equipo de Omnimind."
>

  <!-- HERO -->
  <section class="page-hero section-dark" aria-label="Blog de Omnimind">
    <div class="container page-hero__inner">
      <span class="section-heading__eyebrow">Blog y recursos</span>
      <h1 class="page-hero__title">Contenido basado en evidencia</h1>
      <p class="page-hero__lead">
        Reflexiones, recursos y artículos sobre productividad, bienestar
        organizacional y neurociencias aplicadas al trabajo.
      </p>
    </div>
  </section>

  <!-- LISTA DE POSTS -->
  <section class="section" aria-labelledby="blog-lista-heading">
    <div class="container">
      <h2 class="sr-only" id="blog-lista-heading">Artículos del blog</h2>

      {posts.length === 0 ? (
        <div class="blog-empty">
          <p class="blog-empty__text">Aún no hay artículos publicados. ¡Pronto habrá contenido aquí!</p>
          <a href="/" class="btn btn-primary">Volver al inicio</a>
        </div>
      ) : (
        <div class="blog-grid">
          {posts.map((post, index) => {
            const date = post.data.publishDate || post.data.pubDate;
            const isFeatured = index === 0;
            return (
              <article class={`blog-card ${isFeatured ? 'blog-card--featured' : ''}`} aria-label={post.data.title}>
                <div class="blog-card__img-wrap">
                  {post.data.cover
                    ? <img class="blog-card__img" src={post.data.cover} alt={post.data.coverAlt || post.data.title} width="720" height="360" loading={isFeatured ? 'eager' : 'lazy'} />
                    : <div class="img-placeholder blog-card__img-ph" aria-label={`Imagen: ${post.data.title}`}>📰 Blog</div>
                  }
                </div>
                <div class="blog-card__body">
                  <div class="blog-card__meta">
                    {post.data.category && (
                      <span class="blog-card__category">{post.data.category}</span>
                    )}
                    {post.data.featured && (
                      <span class="blog-card__badge">★ Destacado</span>
                    )}
                  </div>
                  <h2 class={`blog-card__title ${isFeatured ? 'blog-card__title--lg' : ''}`}>
                    <a href={`/blog/${post.id}/`} class="blog-card__link">{post.data.title}</a>
                  </h2>
                  <p class="blog-card__excerpt">{post.data.description}</p>
                  <div class="blog-card__footer">
                    {date && (
                      <time class="blog-card__date" datetime={date.toISOString()}>
                        {date.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
                      </time>
                    )}
                    {post.data.author && (
                      <span class="blog-card__author">· {post.data.author}</span>
                    )}
                  </div>
                  <a href={`/blog/${post.id}/`} class="btn btn-outline-dark blog-card__cta">
                    Leer artículo →
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero { padding-block: 4rem 3.5rem; }
  .page-hero__inner { text-align: center; max-width: 680px; margin-inline: auto; }
  .page-hero__title { font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl)); color: var(--color-text-on-dark); margin-block: 0.75rem 1.25rem; }
  .page-hero__lead  { font-size: var(--text-lg); color: var(--color-text-on-dark-soft); line-height: 1.7; margin: 0; }

  /* ── BLOG GRID ── */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  /* Primer post: ocupa toda la fila */
  .blog-card--featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .blog-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: box-shadow var(--transition-slow), transform var(--transition-slow);
  }

  .blog-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .blog-card--featured:hover {
    transform: translateY(-2px);
  }

  .blog-card__img-wrap { overflow: hidden; }

  .blog-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 220px;
    transition: transform var(--transition-slow);
  }

  .blog-card--featured .blog-card__img { min-height: 380px; }

  .blog-card:hover .blog-card__img { transform: scale(1.03); }

  .blog-card__img-ph { min-height: 220px; border-radius: 0; }
  .blog-card--featured .blog-card__img-ph { min-height: 380px; }

  .blog-card__body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .blog-card__category {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-dark);
  }

  .blog-card__badge {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    background: #f59e0b;
    color: #fff;
    padding: 0.15em 0.5em;
    border-radius: var(--radius-pill);
  }

  .blog-card__title { font-size: var(--text-xl); margin: 0; line-height: 1.3; }
  .blog-card__title--lg { font-size: clamp(var(--text-2xl), 3vw, var(--text-4xl)); }

  .blog-card__link { color: var(--color-brand-primary); text-decoration: none; }
  .blog-card__link:hover { text-decoration: underline; }

  .blog-card__excerpt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card--featured .blog-card__excerpt {
    -webkit-line-clamp: 5;
  }

  .blog-card__footer {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
  }

  .blog-card__cta {
    align-self: flex-start;
    font-size: var(--text-sm);
    padding: 0.5rem 1.1rem;
    margin-top: auto;
  }

  /* ── EMPTY STATE ── */
  .blog-empty {
    text-align: center;
    padding-block: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .blog-empty__text { color: var(--color-text-muted); font-size: var(--text-lg); }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .blog-card--featured {
      grid-template-columns: 1fr;
    }

    .blog-card--featured .blog-card__img,
    .blog-card--featured .blog-card__img-ph {
      min-height: 240px;
    }
  }
</style>
