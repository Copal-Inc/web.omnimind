---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Soluciones"
  description="Tres líneas de intervención organizacional basadas en evidencia: Empowermind, Neurowise y Wealth & Mind. Talleres y programas a medida para tu equipo."
>

  <!-- ════════════════════════════════════════════
       HERO INTERNO
  ════════════════════════════════════════════ -->
  <section class="page-hero section-dark" aria-label="Soluciones Omnimind">
    <div class="container page-hero__inner">
      <span class="section-heading__eyebrow">Nuestras soluciones</span>
      <h1 class="page-hero__title">Tres líneas de intervención,<br />un solo propósito</h1>
      <p class="page-hero__lead">
        Diseñamos e implementamos talleres y programas para organizaciones que
        buscan mejorar el bienestar, la productividad y la resiliencia de sus equipos.
      </p>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       TARJETAS DE SERVICIOS
  ════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="servicios-lista-heading">
    <div class="container">
      <h2 class="sr-only" id="servicios-lista-heading">Lista de servicios</h2>

      <!-- Empowermind -->
      <article class="servicio-row" aria-labelledby="empowermind-heading">
        <div class="servicio-row__media">
          <div class="img-placeholder servicio-row__img" aria-label="Imagen Empowermind — placeholder">
            🧑‍💼 Empowermind
          </div>
        </div>
        <div class="servicio-row__content">
          <span class="servicio-row__num" aria-hidden="true">01</span>
          <h2 class="servicio-row__title" id="empowermind-heading">Empowermind</h2>
          <p class="servicio-row__desc">
            Creamos ambientes y habilidades laborales que benefician la
            productividad y el desarrollo de los individuos en los equipos de
            trabajo. A través de talleres dinámicos y metodologías probadas,
            potenciamos el liderazgo, la comunicación y la organización.
          </p>
          <ul class="servicio-row__tags" role="list">
            <li>Organización</li>
            <li>Productividad</li>
            <li>Liderazgo</li>
            <li>Comunicación</li>
          </ul>
          <a href="/servicios/empowermind/" class="btn btn-primary">
            Ver Empowermind →
          </a>
        </div>
      </article>

      <hr class="servicio-divider" aria-hidden="true" />

      <!-- Neurowise -->
      <article class="servicio-row servicio-row--reverse" aria-labelledby="neurowise-heading">
        <div class="servicio-row__media">
          <div class="img-placeholder servicio-row__img" aria-label="Imagen Neurowise — placeholder">
            🧠 Neurowise
          </div>
        </div>
        <div class="servicio-row__content">
          <span class="servicio-row__num" aria-hidden="true">02</span>
          <h2 class="servicio-row__title" id="neurowise-heading">Neurowise</h2>
          <p class="servicio-row__desc">
            Consultoría e intervenciones basadas en el estado del arte de la
            investigación en neurociencias para mejorar la productividad de tu
            equipo. Aplicamos ciencia real para impulsar la flexibilidad cognitiva
            y la adaptabilidad en entornos de alta exigencia.
          </p>
          <ul class="servicio-row__tags" role="list">
            <li>Neurociencias</li>
            <li>Flexibilidad cognitiva</li>
            <li>Adaptabilidad</li>
            <li>Resiliencia</li>
          </ul>
          <a href="/servicios/neurowise/" class="btn btn-primary">
            Ver Neurowise →
          </a>
        </div>
      </article>

      <hr class="servicio-divider" aria-hidden="true" />

      <!-- Wealth & Mind -->
      <article class="servicio-row" aria-labelledby="wealth-heading">
        <div class="servicio-row__media">
          <div class="img-placeholder servicio-row__img" aria-label="Imagen Wealth & Mind — placeholder">
            🌱 Wealth & Mind
          </div>
        </div>
        <div class="servicio-row__content">
          <span class="servicio-row__num" aria-hidden="true">03</span>
          <h2 class="servicio-row__title" id="wealth-heading">Wealth &amp; Mind</h2>
          <p class="servicio-row__desc">
            Ponemos la salud mental al frente. Intervenciones para prevenir
            riesgos psicosociales y crear ambientes saludables en empresas o
            comunidades. Bienestar real que se refleja en resultados reales.
          </p>
          <ul class="servicio-row__tags" role="list">
            <li>Salud mental</li>
            <li>Bienestar</li>
            <li>Riesgos psicosociales</li>
            <li>NOM-035</li>
          </ul>
          <a href="/servicios/wealth-mind/" class="btn btn-primary">
            Ver Wealth &amp; Mind →
          </a>
        </div>
      </article>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       CTA COTIZACIÓN
  ════════════════════════════════════════════ -->
  <section class="section section-dark" aria-labelledby="cta-servicios-heading">
    <div class="container cta-simple">
      <h2 id="cta-servicios-heading">¿No sabes cuál se adapta mejor a tu empresa?</h2>
      <p>Platícanos el reto y te recomendamos la intervención ideal — o una combinación.</p>
      <a href="/contacto/" class="btn btn-accent">Solicitar cotización</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── PAGE HERO ── */
  .page-hero {
    padding-block: 4rem 3.5rem;
  }

  .page-hero__inner {
    text-align: center;
    max-width: 760px;
    margin-inline: auto;
  }

  .page-hero__title {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    color: var(--color-text-on-dark);
    margin-block: 0.75rem 1.25rem;
  }

  .page-hero__lead {
    font-size: var(--text-lg);
    color: var(--color-text-on-dark-soft);
    line-height: 1.7;
    margin: 0;
  }

  /* ── SERVICIO ROW ── */
  .servicio-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    padding-block: 2rem;
  }

  .servicio-row--reverse .servicio-row__media {
    order: 2;
  }

  .servicio-row--reverse .servicio-row__content {
    order: 1;
  }

  .servicio-row__img {
    min-height: 320px;
    border-radius: var(--radius-lg);
  }

  .servicio-row__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .servicio-row__num {
    font-family: var(--font-heading);
    font-size: var(--text-5xl);
    font-weight: 800;
    color: var(--color-border);
    line-height: 1;
  }

  .servicio-row__title {
    font-size: clamp(var(--text-2xl), 3vw, var(--text-4xl));
    margin: 0;
  }

  .servicio-row__desc {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }

  .servicio-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .servicio-row__tags li {
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 0.25em 0.7em;
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
  }

  .servicio-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0;
  }

  /* ── CTA SIMPLE ── */
  .cta-simple {
    text-align: center;
    max-width: 620px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .cta-simple h2 { color: var(--color-text-on-dark); margin: 0; }
  .cta-simple p  { color: var(--color-text-on-dark-soft); margin: 0; }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .servicio-row {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .servicio-row--reverse .servicio-row__media,
    .servicio-row--reverse .servicio-row__content {
      order: unset;
    }
  }
</style>
