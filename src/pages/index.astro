---
import { url } from '../lib/url';
import { getCollection } from "astro:content";
import NeuralField from "../components/NeuralField.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// Últimos 3 posts para la sección de blog
const allPosts = await getCollection("blog");
const recentPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => {
    const da = a.data.publishDate || a.data.pubDate || new Date(0);
    const db = b.data.publishDate || b.data.pubDate || new Date(0);
    return db.valueOf() - da.valueOf();
  })
  .slice(0, 3);
---

<BaseLayout
  title="OMNIMIND — Reinventando la Productividad"
  description="Workshops e intervenciones organizacionales basadas en evidencia. Empowermind, Wealth & Mind y Neurowise para equipos que buscan crecer."
>
  <!-- ════════════════════════════════════════════════
       HERO
  ════════════════════════════════════════════════ -->
  <section
    class="hero"
    aria-label="Hero — propuesta de valor principal"
    data-mouse-parallax
  >
    <!-- Imagen de fondo (placeholder hasta tener foto oficial aprobada).
         data-depth invierte el movimiento del cursor → sensación de profundidad. -->
    <div class="hero__bg" aria-hidden="true" data-depth="-14"></div>

    <!-- Auroras + red neuronal reactiva al cursor -->
    <NeuralField density={1.15} parallax />

    <div class="container hero__content">
      <p class="hero__eyebrow" data-enter style="--enter-delay: 120ms">
        Intervenciones organizacionales basadas en evidencia
      </p>
      <h1 class="hero__title" data-enter style="--enter-delay: 220ms">
        Reinventando la<br />
        <span class="hero__title-accent text-shine">Productividad</span>
      </h1>
      <p class="hero__body" data-enter style="--enter-delay: 340ms">
        Somos una empresa dedicada al crecimiento de las personas, enfocándonos
        en el equilibrio para lograr una vida exitosa y plena. Nos
        especializamos en talleres y comunidades tanto empresariales como
        sociales.
      </p>
      <div class="hero__actions" data-enter style="--enter-delay: 450ms">
        <!-- Acento teal: sobre el índigo del hero el azul de marca
             no separaba lo suficiente al CTA principal. -->
        <a
          href={url("/contacto/")}
          class="btn btn-accent hero__cta-primary"
          data-magnetic="0.2"
        >
          <span class="btn__label">Solicitar cotización</span>
        </a>
        <a
          href={url("/servicios/")}
          class="btn btn-outline hero__cta-secondary"
          data-magnetic="0.2"
        >
          <span class="btn__label">Explorar soluciones</span>
        </a>
      </div>
    </div>

    <a class="scroll-hint" href="#soluciones" aria-label="Ir a las soluciones">
      <span>Desliza</span>
      <span class="scroll-hint__line" aria-hidden="true"></span>
    </a>
  </section>

  <!-- ════════════════════════════════════════════════
       TIRA DE CREDIBILIDAD (placeholder)
  ════════════════════════════════════════════════ -->
  <section
    class="credibility-strip section-muted"
    aria-label="Indicadores de credibilidad"
  >
    <div class="container credibility-strip__inner" data-stagger="110">
      <div class="credibility-item" data-reveal="up">
        <span class="credibility-item__number" data-count="+50">+50</span>
        <span class="credibility-item__label">Organizaciones acompañadas</span>
      </div>
      <div class="credibility-divider" aria-hidden="true"></div>
      <div class="credibility-item" data-reveal="up">
        <span class="credibility-item__number" data-count="3">3</span>
        <span class="credibility-item__label">Líneas de intervención</span>
      </div>
      <div class="credibility-divider" aria-hidden="true"></div>
      <div class="credibility-item" data-reveal="up">
        <span class="credibility-item__number" data-count="100%">100%</span>
        <span class="credibility-item__label">Talleres a medida</span>
      </div>
      <div class="credibility-divider" aria-hidden="true"></div>
      <div class="credibility-item" data-reveal="up">
        <span class="credibility-item__number">B2B</span>
        <span class="credibility-item__label">Enfoque empresarial</span>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════
       LÍNEAS DE SERVICIO
  ════════════════════════════════════════════════ -->
  <section
    class="section services"
    id="soluciones"
    aria-labelledby="services-heading"
  >
    <div class="container">
      <div class="section-heading" data-stagger="120">
        <span class="section-heading__eyebrow" data-reveal="up"
          >Nuestras soluciones</span
        >
        <h2 class="section-heading__title" id="services-heading" data-reveal="up">
          Tres líneas de intervención, un solo propósito
        </h2>
        <p class="section-heading__body" data-reveal="up">
          Diseñamos e implementamos talleres y programas para organizaciones que
          buscan mejorar el bienestar, la productividad y la resiliencia de sus
          equipos.
        </p>
      </div>

      <div class="grid-3 services__grid" data-stagger="140">
        <!-- Empowermind -->
        <article
          class="service-card service-card--empowermind card-hover"
          data-reveal="up"
          data-tilt="4"
          data-spotlight
        >
          <div class="service-card__img-wrap card-media">
            <!-- Placeholder de imagen — pendiente foto aprobada -->
            <div
              class="img-placeholder service-card__img-placeholder"
              aria-label="Imagen Empowermind — placeholder"
            >
              🧑‍💼 Empowermind
            </div>
          </div>
          <div class="service-card__body">
            <div class="service-card__badge" aria-hidden="true">01</div>
            <h3 class="service-card__title">
              <a href={url("/servicios/empowermind/")} class="service-card__link"
                >Empowermind</a
              >
            </h3>
            <p class="service-card__desc">
              Creamos ambientes y habilidades laborales que benefician la
              productividad y el desarrollo de los individuos en los equipos de
              trabajo.
            </p>
            <ul class="service-card__tags" role="list">
              <li>Organización</li>
              <li>Productividad</li>
              <li>Liderazgo</li>
            </ul>
            <a
              href={url("/servicios/empowermind/")}
              class="btn btn-outline-dark service-card__cta"
            >
              Conocer más <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        <!-- Neurowise -->
        <article
          class="service-card service-card--neurowise card-hover"
          data-reveal="up"
          data-tilt="4"
          data-spotlight
        >
          <div class="service-card__img-wrap card-media">
            <div
              class="img-placeholder service-card__img-placeholder"
              aria-label="Imagen Neurowise — placeholder"
            >
              🧠 Neurowise
            </div>
          </div>
          <div class="service-card__body">
            <div class="service-card__badge" aria-hidden="true">02</div>
            <h3 class="service-card__title">
              <a href={url("/servicios/neurowise/")} class="service-card__link"
                >Neurowise</a
              >
            </h3>
            <p class="service-card__desc">
              Consultoría e intervenciones basadas en el estado del arte de la
              investigación en neurociencias para mejorar la productividad de tu
              equipo.
            </p>
            <ul class="service-card__tags" role="list">
              <li>Neurociencias</li>
              <li>Flexibilidad cognitiva</li>
              <li>Adaptabilidad</li>
            </ul>
            <a
              href={url("/servicios/neurowise/")}
              class="btn btn-outline-dark service-card__cta"
            >
              Conocer más <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        <!-- Wealth & Mind -->
        <article
          class="service-card service-card--wealth card-hover"
          data-reveal="up"
          data-tilt="4"
          data-spotlight
        >
          <div class="service-card__img-wrap card-media">
            <div
              class="img-placeholder service-card__img-placeholder"
              aria-label="Imagen Wealth & Mind — placeholder"
            >
              🌱 Wealth & Mind
            </div>
          </div>
          <div class="service-card__body">
            <div class="service-card__badge" aria-hidden="true">03</div>
            <h3 class="service-card__title">
              <a href={url("/servicios/wealth-mind/")} class="service-card__link"
                >Wealth & Mind</a
              >
            </h3>
            <p class="service-card__desc">
              Ponemos la salud mental al frente. Intervenciones para prevenir
              riesgos psicosociales y crear ambientes saludables en empresas o
              comunidades.
            </p>
            <ul class="service-card__tags" role="list">
              <li>Salud mental</li>
              <li>Bienestar</li>
              <li>Riesgos psicosociales</li>
            </ul>
            <a
              href={url("/servicios/wealth-mind/")}
              class="btn btn-outline-dark service-card__cta"
            >
              Conocer más <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════
       SOBRE OMNIMIND (breve introducción)
  ════════════════════════════════════════════════ -->
  <section
    class="section section-muted about-intro"
    aria-labelledby="about-heading"
  >
    <div class="container about-intro__grid">
      <div class="about-intro__image" data-reveal="left">
        <!-- Placeholder de imagen del equipo — pendiente foto aprobada -->
        <div
          class="img-placeholder about-intro__img-placeholder"
          aria-label="Equipo Omnimind — imagen placeholder"
        >
          📸 Foto del equipo<br />(pendiente aprobación)
        </div>
      </div>
      <div class="about-intro__content" data-stagger="110">
        <span class="section-heading__eyebrow" data-reveal="right"
          >Sobre nosotros</span
        >
        <h2 id="about-heading" data-reveal="right">
          Una empresa dedicada al crecimiento humano
        </h2>
        <p data-reveal="right">
          En Omnimind creemos que una mente sana es una mente próspera. Por eso
          diseñamos e implementamos intervenciones organizacionales con base
          científica, siempre dándole el toque humano a todo nuestro trabajo.
        </p>
        <p data-reveal="right">
          Nos especializamos en el manejo de comunidades tanto empresariales
          como sociales, acompañando a organizaciones en su camino hacia el
          bienestar y la productividad sostenible.
        </p>
        <a
          href={url("/sobre-nosotros/")}
          class="btn btn-primary about-intro__cta"
          data-reveal="right"
        >
          Conocer nuestro equipo
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════
       ARTÍCULOS RECIENTES
  ════════════════════════════════════════════════ -->
  {
    recentPosts.length > 0 && (
      <section class="section blog-recent" aria-labelledby="blog-heading">
        <div class="container">
          <div class="section-heading" data-stagger="120">
            <span class="section-heading__eyebrow" data-reveal="up">
              Blog y recursos
            </span>
            <h2 class="section-heading__title" id="blog-heading" data-reveal="up">
              Últimos artículos
            </h2>
            <p class="section-heading__body" data-reveal="up">
              Contenido basado en evidencia sobre productividad, bienestar y
              neurociencias aplicadas a las organizaciones.
            </p>
          </div>

          <div class="grid-3 blog-recent__grid" data-stagger="130">
            {recentPosts.map((post) => {
              const date = post.data.publishDate || post.data.pubDate;
              return (
                <article
                  class="blog-card card-hover"
                  data-reveal="up"
                  data-spotlight
                >
                  <div class="blog-card__img-wrap card-media">
                    <div
                      class="img-placeholder blog-card__img"
                      aria-label={`Imagen del artículo: ${post.data.title}`}
                    >
                      📰 Blog
                    </div>
                  </div>
                  <div class="blog-card__body">
                    {post.data.category && (
                      <span class="blog-card__category">
                        {post.data.category}
                      </span>
                    )}
                    <h3 class="blog-card__title">
                      <a href={url(`/blog/${post.id}/`)} class="blog-card__link">
                        {post.data.title}
                      </a>
                    </h3>
                    <p class="blog-card__excerpt">{post.data.description}</p>
                    {date && (
                      <time
                        class="blog-card__date"
                        datetime={date.toISOString()}
                      >
                        {date.toLocaleDateString("es-MX", {
                          year: "numeric",
                          month: "long",
                          day: "numeric",
                        })}
                      </time>
                    )}
                  </div>
                </article>
              );
            })}
          </div>

          <div class="blog-recent__more" data-reveal="up">
            <a href={url("/blog/")} class="btn btn-outline-dark">
              Ver todos los artículos
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- ════════════════════════════════════════════════
       CTA FINAL — COTIZACIÓN
  ════════════════════════════════════════════════ -->
  <section
    class="section section-dark quote-cta"
    aria-labelledby="quote-cta-heading"
  >
    <NeuralField density={0.7} />

    <div class="container quote-cta__inner" data-stagger="120">
      <div class="quote-cta__content">
        <h2 id="quote-cta-heading" class="quote-cta__title" data-reveal="up">
          ¿Listo para transformar tu organización?
        </h2>
        <p class="quote-cta__body" data-reveal="up">
          Cuéntanos el reto que enfrenta tu equipo y diseñamos una intervención
          a la medida de tu organización.
        </p>
        <div class="quote-cta__actions" data-reveal="up">
          <a href={url("/contacto/")} class="btn btn-accent" data-magnetic="0.18">
            <span class="btn__label">Solicitar una cotización</span>
          </a>
          <a href={url("/servicios/")} class="btn btn-outline" data-magnetic="0.18">
            <span class="btn__label">Explorar soluciones</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── HERO ── */
  .hero {
    position: relative;
    min-height: 620px;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #fff;
  }

  .hero__bg {
    position: absolute;
    inset: -6%;
    background:
      linear-gradient(
        135deg,
        rgba(26, 35, 126, 0.88) 0%,
        rgba(42, 76, 144, 0.75) 50%,
        rgba(26, 35, 126, 0.65) 100%
      ),
      /* Placeholder de imagen — pendiente foto de taller aprobada */
      linear-gradient(160deg, #1a237e 0%, #2a4c90 60%, #34ab9f 100%);
    background-size: cover;
    background-position: center;
    z-index: 0;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-block: 6rem;
    max-width: 900px;
    text-align: center;
  }

  .hero__eyebrow {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .hero__title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  /* El color lo aporta .text-shine (gradiente animado) */
  .hero__title-accent {
    display: inline-block;
    padding-bottom: 0.08em;
  }

  .hero__body {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 780px;
    margin-inline: auto;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ── CREDIBILITY STRIP ── */
  .credibility-strip {
    padding-block: 3rem;
    border-block: 1px solid var(--color-border);
  }

  .credibility-strip__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3.5rem;
    flex-wrap: wrap;
  }

  .credibility-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.25rem;
    transition: transform var(--dur-3, 0.45s) var(--ease-out-back, ease);
  }

  .credibility-item:hover {
    transform: translateY(-4px);
  }

  .credibility-item__number {
    font-family: var(--font-heading);
    font-size: var(--text-5xl);
    font-weight: 650;
    color: var(--color-brand-primary);
    line-height: 1;
    transition: color var(--dur-2, 0.28s) var(--ease-out-quart, ease);
  }

  .credibility-item:hover .credibility-item__number {
    color: var(--color-accent-dark);
  }

  .credibility-item__label {
    font-size: var(--text-m);
    padding-top: 0.5rem;
    color: var(--color-text-muted);
    font-weight: 500;
    max-width: 120px;
    text-align: center;
  }

  .credibility-divider {
    width: 2px;
    height: 70px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-border-strong),
      transparent
    );
    flex-shrink: 0;
  }

  /* ── SERVICE CARDS ── */
  .services__grid {
    align-items: stretch;
  }

  .service-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition:
      box-shadow var(--dur-3, 0.45s) var(--ease-out-quart, ease),
      border-color var(--dur-3, 0.45s) var(--ease-out-quart, ease),
      transform var(--dur-3, 0.45s) var(--ease-out-quart, ease);
  }

  .service-card:hover {
    box-shadow: var(--shadow-lg);
    border-color: rgba(52, 171, 159, 0.45);
  }

  .service-card__img-placeholder {
    min-height: 180px;
    border-radius: 0;
  }

  .service-card__body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .service-card__badge {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 800;
    color: var(--color-border);
    line-height: 1;
    margin-bottom: -0.25rem;
    transition:
      color var(--dur-3, 0.45s) var(--ease-out-quart, ease),
      transform var(--dur-3, 0.45s) var(--ease-out-back, ease);
  }

  .service-card:hover .service-card__badge {
    color: var(--color-accent);
    transform: translateX(4px);
  }

  .service-card__title {
    font-size: var(--text-xl);
    margin: 0;
  }

  .service-card__link {
    color: var(--color-brand-primary);
    text-decoration: none;
    background-image: linear-gradient(
      var(--color-accent),
      var(--color-accent)
    );
    background-repeat: no-repeat;
    background-size: 0% 2px;
    background-position: 0 100%;
    transition:
      background-size var(--dur-3, 0.45s) var(--ease-out-quart, ease),
      color var(--dur-2, 0.28s) var(--ease-out-quart, ease);
  }

  .service-card:hover .service-card__link,
  .service-card__link:hover {
    color: var(--color-accent-dark);
    background-size: 100% 2px;
  }

  .service-card__desc {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .service-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .service-card__tags li {
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 0.2em 0.6em;
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    transition:
      background-color var(--dur-2, 0.28s) var(--ease-out-quart, ease),
      border-color var(--dur-2, 0.28s) var(--ease-out-quart, ease),
      color var(--dur-2, 0.28s) var(--ease-out-quart, ease),
      transform var(--dur-2, 0.28s) var(--ease-out-back, ease);
  }

  .service-card__tags li:hover {
    background: rgba(52, 171, 159, 0.12);
    border-color: rgba(52, 171, 159, 0.4);
    color: var(--color-accent-dark);
    transform: translateY(-2px);
  }

  .service-card__cta {
    margin-top: auto;
    align-self: flex-start;
    font-size: var(--text-sm);
    padding: 0.5rem 1.1rem;
  }

  /* ── ABOUT INTRO ── */
  .about-intro__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .about-intro__img-placeholder {
    min-height: 320px;
    border-radius: var(--radius-lg);
  }

  .about-intro__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about-intro__content h2 {
    margin-top: 0.5rem;
  }

  .about-intro__content p {
    color: var(--color-text-muted);
  }

  .about-intro__cta {
    align-self: flex-start;
  }

  /* ── BLOG CARDS ── */
  .blog-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition:
      box-shadow var(--dur-3, 0.45s) var(--ease-out-quart, ease),
      border-color var(--dur-3, 0.45s) var(--ease-out-quart, ease),
      transform var(--dur-3, 0.45s) var(--ease-out-quart, ease);
  }

  .blog-card:hover {
    box-shadow: var(--shadow-lg);
    border-color: rgba(52, 171, 159, 0.4);
    transform: translateY(-5px);
  }

  .blog-card__img {
    min-height: 160px;
    border-radius: 0;
  }

  .blog-card__body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .blog-card__category {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-dark);
  }

  .blog-card__title {
