---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sobre Nosotras"
  description="Conoce al equipo de Omnimind: quiénes somos, nuestra misión y por qué creemos que una mente sana es una mente próspera."
>

  <!-- ════════════════════════════════════════════
       HERO INTERNO
  ════════════════════════════════════════════ -->
  <section class="page-hero section-dark" aria-label="Sobre Omnimind">
    <div class="container page-hero__inner">
      <span class="section-heading__eyebrow">Sobre nosotras</span>
      <h1 class="page-hero__title">Una empresa dedicada<br />al crecimiento humano</h1>
      <p class="page-hero__lead">
        En Omnimind creemos que una mente sana es una mente próspera. Por eso
        diseñamos e implementamos intervenciones organizacionales con base
        científica, siempre dándole el toque humano a todo nuestro trabajo.
      </p>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       MISIÓN Y VISIÓN
  ════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="mision-heading">
    <div class="container mv-grid">
      <div class="mv-card mv-card--mision">
        <div class="mv-card__icon" aria-hidden="true">🎯</div>
        <h2 class="mv-card__title" id="mision-heading">Nuestra misión</h2>
        <p class="mv-card__body">
          Acompañar a organizaciones y comunidades en el desarrollo de ambientes
          de trabajo saludables, productivos y sostenibles, a través de
          intervenciones basadas en evidencia científica.
        </p>
      </div>
      <div class="mv-card mv-card--vision">
        <div class="mv-card__icon" aria-hidden="true">🌐</div>
        <h2 class="mv-card__title">Nuestra visión</h2>
        <p class="mv-card__body">
          Ser la referencia en bienestar organizacional en México y
          Latinoamérica, impulsando que cada persona que forma parte de una
          organización pueda desarrollar su máximo potencial.
        </p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       VALORES
  ════════════════════════════════════════════ -->
  <section class="section section-muted" aria-labelledby="valores-heading">
    <div class="container">
      <div class="section-heading">
        <span class="section-heading__eyebrow">Lo que nos define</span>
        <h2 class="section-heading__title" id="valores-heading">Nuestros valores</h2>
      </div>
      <ul class="valores-grid" role="list">
        <li class="valor-card">
          <span class="valor-card__icon" aria-hidden="true">🔬</span>
          <h3 class="valor-card__title">Basadas en evidencia</h3>
          <p class="valor-card__body">
            Cada intervención que diseñamos tiene respaldo científico. No improvisamos
            ni seguimos modas; aplicamos lo que la investigación demuestra que funciona.
          </p>
        </li>
        <li class="valor-card">
          <span class="valor-card__icon" aria-hidden="true">🤝</span>
          <h3 class="valor-card__title">Toque humano</h3>
          <p class="valor-card__body">
            La ciencia nos guía, pero las personas nos mueven. Cada programa lo
            adaptamos a la cultura, retos y contexto únicos de cada organización.
          </p>
        </li>
        <li class="valor-card">
          <span class="valor-card__icon" aria-hidden="true">♻️</span>
          <h3 class="valor-card__title">Impacto sostenible</h3>
          <p class="valor-card__body">
            No buscamos resultados de un día. Diseñamos cambios que perduran y que
            las propias organizaciones pueden mantener y escalar.
          </p>
        </li>
        <li class="valor-card">
          <span class="valor-card__icon" aria-hidden="true">🌱</span>
          <h3 class="valor-card__title">Crecimiento integral</h3>
          <p class="valor-card__body">
            Creemos en el equilibrio entre la vida personal y profesional como
            base para una productividad real y duradera.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       EQUIPO (placeholder)
  ════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="equipo-heading">
    <div class="container">
      <div class="section-heading">
        <span class="section-heading__eyebrow">Las personas detrás</span>
        <h2 class="section-heading__title" id="equipo-heading">Nuestro equipo</h2>
        <p class="section-heading__body">
          Un equipo multidisciplinario de psicólogas, coaches y especialistas en
          neurociencias comprometidas con tu organización.
        </p>
      </div>

      <div class="grid-3 team-grid">
        <!-- Placeholder — pendiente fotos y bios aprobadas -->
        <article class="team-card">
          <div class="img-placeholder team-card__photo" aria-label="Foto del equipo — pendiente">
            👤 Integrante del equipo
          </div>
          <div class="team-card__info">
            <h3 class="team-card__name">Nombre Apellido</h3>
            <p class="team-card__role">Fundadora / Directora</p>
            <p class="team-card__bio">
              Placeholder — pendiente bio aprobada por Omnimind.
            </p>
          </div>
        </article>
        <article class="team-card">
          <div class="img-placeholder team-card__photo" aria-label="Foto del equipo — pendiente">
            👤 Integrante del equipo
          </div>
          <div class="team-card__info">
            <h3 class="team-card__name">Nombre Apellido</h3>
            <p class="team-card__role">Especialista en Neurociencias</p>
            <p class="team-card__bio">
              Placeholder — pendiente bio aprobada por Omnimind.
            </p>
          </div>
        </article>
        <article class="team-card">
          <div class="img-placeholder team-card__photo" aria-label="Foto del equipo — pendiente">
            👤 Integrante del equipo
          </div>
          <div class="team-card__info">
            <h3 class="team-card__name">Nombre Apellido</h3>
            <p class="team-card__role">Coach Organizacional</p>
            <p class="team-card__bio">
              Placeholder — pendiente bio aprobada por Omnimind.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       CTA
  ════════════════════════════════════════════ -->
  <section class="section section-dark" aria-labelledby="cta-about-heading">
    <div class="container cta-simple">
      <h2 id="cta-about-heading">¿Quieres conocer más sobre nosotras?</h2>
      <p>Platícanos sobre tu organización y diseñamos una solución a la medida.</p>
      <a href="/contacto/" class="btn btn-accent">Escríbenos</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── PAGE HERO ── */
  .page-hero {
    padding-block: 4rem 3.5rem;
  }

  .page-hero__inner {
    text-align: center;
    max-width: 760px;
    margin-inline: auto;
  }

  .page-hero__title {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    color: var(--color-text-on-dark);
    margin-block: 0.75rem 1.25rem;
  }

  .page-hero__lead {
    font-size: var(--text-lg);
    color: var(--color-text-on-dark-soft);
    line-height: 1.7;
    margin: 0;
  }

  /* ── MISIÓN / VISIÓN ── */
  .mv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .mv-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }

  .mv-card--mision {
    border-top: 4px solid var(--color-brand-primary);
  }

  .mv-card--vision {
    border-top: 4px solid var(--color-accent);
  }

  .mv-card__icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    display: block;
  }

  .mv-card__title {
    font-size: var(--text-2xl);
    margin-bottom: 0.75rem;
  }

  .mv-card__body {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }

  /* ── VALORES ── */
  .valores-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .valor-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-slow), transform var(--transition-slow);
  }

  .valor-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .valor-card__icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 0.75rem;
  }

  .valor-card__title {
    font-size: var(--text-xl);
    margin-bottom: 0.5rem;
  }

  .valor-card__body {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  /* ── EQUIPO ── */
  .team-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-slow), transform var(--transition-slow);
  }

  .team-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .team-card__photo {
    min-height: 220px;
    border-radius: 0;
  }

  .team-card__info {
    padding: 1.5rem;
  }

  .team-card__name {
    font-size: var(--text-xl);
    margin-bottom: 0.25rem;
  }

  .team-card__role {
    color: var(--color-accent-dark);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .team-card__bio {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  /* ── CTA ── */
  .cta-simple {
    text-align: center;
    max-width: 600px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .cta-simple h2 {
    color: var(--color-text-on-dark);
    margin: 0;
  }

  .cta-simple p {
    color: var(--color-text-on-dark-soft);
    margin: 0;
  }
</style>
