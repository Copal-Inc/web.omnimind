---
import { url, base } from "../lib/url";
import { SITE_TITLE } from "../consts";

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const pathname = Astro.url.pathname;

const navLinks = [
  { href: url("/"), label: "Inicio" },
  { href: url("/sobre-nosotros/"), label: "Sobre Omnimind" },
  {
    href: url("/servicios/"),
    label: "Soluciones",
    children: [
      { href: url("/servicios/empowermind/"), label: "Empowermind" },
      { href: url("/servicios/wealth-mind/"), label: "Wealth & Mind" },
      { href: url("/servicios/neurowise/"), label: "Neurowise" },
    ],
  },
  { href: url("/blog/"), label: "Blog" },
];

function isActive(href: string): boolean {
  // El enlace de inicio necesita coincidir exactamente para no marcarse en todas las páginas
  if (href === "/" || href === `${base}/`) {
    return pathname === href || pathname === base;
  }
  return pathname.startsWith(href);
}
---

<header
  class={`site-header${transparent ? " site-header--transparent" : ""}`}
  id="site-header"
>
  <!-- Barra superior: Logo -->
  <div class="header-top">
    <div class="container">
      <a href={url("/")} class="logo" aria-label="Omnimind — Inicio">
        <div class="logo__icon" aria-hidden="true">
          <img
            src={url("/img/icononly_transparent_nobuffer.png")}
            alt=""
            width="56"
            height="56"
            class="logo__img"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="logo__text">
          <span class="logo__name">{SITE_TITLE}</span>
          <span class="logo__tagline">A healthy mind is a prosper mind</span>
        </div>
      </a>
    </div>
  </div>

  <!-- Barra de navegación principal -->
  <nav class="header-nav" aria-label="Navegación principal">
    <div class="container header-nav__inner">
      <!-- Links de navegación -->
      <ul class="nav-list" role="list">
        {
          navLinks.map((link) => (
            <li class={`nav-item${link.children ? " nav-item--dropdown" : ""}`}>
              {link.children ? (
                <>
                  <button
                    class={`nav-link nav-link--btn${isActive(link.href) ? " active" : ""}`}
                    aria-expanded="false"
                    aria-haspopup="true"
                    id={`dropdown-${link.label.toLowerCase().replace(/\s+/g, "-")}`}
                  >
                    {link.label}
                    <svg
                      class="nav-chevron"
                      width="14"
                      height="14"
                      viewBox="0 0 14 14"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M3 5L7 9L11 5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>
                  <ul
                    class="dropdown"
                    role="list"
                    aria-label={`Submenu ${link.label}`}
                  >
                    {link.children.map((child) => (
                      <li class="dropdown__item">
                        <a
                          href={child.href}
                          class={`dropdown__link${isActive(child.href) ? " active" : ""}`}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  href={link.href}
                  class={`nav-link${isActive(link.href) ? " active" : ""}`}
                >
                  {link.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <!-- CTA principal -->
      <div class="header-cta">
        <a href={url("/contacto/")} class="btn btn-accent nav-cta">
          Solicitar cotización
        </a>
      </div>

      <!-- Botón hamburguesa (mobile) -->
      <button
        class="hamburger"
        id="hamburger-btn"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span class="hamburger__line"></span>
        <span class="hamburger__line"></span>
        <span class="hamburger__line"></span>
      </button>
    </div>

    <!-- Menú móvil -->
    <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
      <div class="container">
        <ul class="mobile-nav-list" role="list">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class={`mobile-nav-link${isActive(link.href) ? " active" : ""}`}
                >
                  {link.label}
                </a>
                {link.children && (
                  <ul class="mobile-sub-list" role="list">
                    {link.children.map((child) => (
                      <li>
                        <a href={child.href} class="mobile-sub-link">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
        <div class="mobile-nav__footer">
          <a href={url("/contacto/")} class="btn btn-primary mobile-cta">
            Solicitar cotización
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  /* ── Header ── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--dur-3, 0.45s) var(--ease-out-quart, ease);
  }

  /* Estado compacto: al bajar, la barra del logo se encoge para dejar
     más superficie de lectura sin perder la marca de vista. */
  .site-header.is-scrolled {
    box-shadow: var(--shadow-md);
  }

  /* ── Barra superior con logo ── */
  .header-top {
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-border);
    background: #f1f4f4;
    transition: padding-block var(--dur-3, 0.45s) var(--ease-out-quart, ease);
  }

  .site-header.is-scrolled .header-top {
    padding-block: 0.45rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    text-decoration: none;
    color: inherit;
  }

  .logo__icon {
    flex-shrink: 0;
    line-height: 1;
    transition: transform var(--dur-3, 0.45s) var(--ease-out-back, ease);
  }

  /* El isotipo gira levemente al pasar el cursor — guiño vivo, no ruido */
  .logo:hover .logo__icon {
    transform: rotate(-8deg) scale(1.06);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .logo__name {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 800;
    letter-spacing: 0.25em;
    color: var(--color-brand-primary);
    line-height: 1;
  }

  .logo__img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    transition:
      width var(--dur-3, 0.45s) var(--ease-out-quart, ease),
      height var(--dur-3, 0.45s) var(--ease-out-quart, ease);
  }

  .site-header.is-scrolled .logo__img {
    width: 40px;
    height: 40px;
  }

  .logo__name {
    transition: font-size var(--dur-3, 0.45s) var(--ease-out-quart, ease);
  }

  .site-header.is-scrolled .logo__name {
    font-size: var(--text-xl);
  }

  .site-header.is-scrolled .logo__tagline {
    opacity: 0;
  }

  .logo__tagline {
    transition: opacity var(--dur-2, 0.28s) var(--ease-out-quart, ease);
  }

  .logo__tagline {
    font-family: var(--font-body);
    font-size: var(--text-s);
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    font-style: italic;
    line-height: 1;
  }

  /* ── Barra de navegación ── */
  .header-nav {
    background: var(--color-brand-secondary);
    position: relative;
  }

  .header-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 52px;
  }

  /* ── Nav list ── */
  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    color: rgba(255, 255, 255, 0.88);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition:
      color var(--dur-2, 0.28s) var(--ease-out-quart, ease),
      background-color var(--dur-2, 0.28s) var(--ease-out-quart, ease);
    white-space: nowrap;
  }

  .nav-link--btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
    padding: 0.9rem 1rem;
  }

  /* Subrayado que crece desde el centro */
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0;
    height: 3px;
    background: var(--color-accent);
    border-radius: 3px 3px 0 0;
    transform: scaleX(0);
    transform-origin: 50% 100%;
    transition: transform var(--dur-2, 0.28s) var(--ease-out-back, ease);
  }

  .nav-link:hover,
  .nav-link.active {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.06);
  }

  .nav-link:hover::after,
  .nav-link.active::after,
  .nav-item--dropdown:focus-within .nav-link::after {
    transform: scaleX(1);
  }

  .nav-chevron {
    transition: transform var(--dur-2, 0.28s) var(--ease-out-back, ease);
  }

  /* ── Dropdown ── */
  .nav-item--dropdown {
    position: relative;
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 210px;
    background: var(--color-surface);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    box-shadow: var(--shadow-lg);
    list-style: none;
    padding: 0.5rem 0;
    margin: 0;
    border-top: 3px solid var(--color-accent);
    z-index: 200;

    /* Entrada con desplazamiento y recorte, en vez de aparecer de golpe */
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transform-origin: top center;
    pointer-events: none;
    transition:
      opacity var(--dur-2, 0.28s) var(--ease-out-quart, ease),
      transform var(--dur-3, 0.45s) var(--ease-out-expo, ease),
      visibility 0s linear var(--dur-3, 0.45s);
  }

  .nav-item--dropdown:hover .dropdown,
  .nav-item--dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
    transition-delay: 0s;
  }

  /* Los enlaces del submenú entran escalonados */
  .dropdown__item {
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity var(--dur-2, 0.28s) var(--ease-out-quart, ease),
      transform var(--dur-2, 0.28s) var(--ease-out-quart, ease);
  }

  .nav-item--dropdown:hover .dropdown__item,
  .nav-item--dropdown:focus-within .dropdown__item {
    opacity: 1;
    transform: translateY(0);
  }

  .dropdown__item:nth-child(1) {
    transition-delay: 40ms;
  }

  .dropdown__item:nth-child(2) {
    transition-delay: 90ms;
  }

  .dropdown__item:nth-child(3) {
    transition-delay: 140ms;
  }

  .nav-item--dropdown:hover .nav-chevron,
  .nav-item--dropdown:focus-within .nav-chevron {
    transform: rotate(180deg);
  }

  .dropdown__link {
    position: relative;
    display: block;
    padding: 0.6rem 1.25rem;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-family: var(--font-heading);
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--dur-2, 0.28s) var(--ease-out-quart, ease),
      color var(--dur-2, 0.28s) var(--ease-out-quart, ease),
      padding-left var(--dur-2, 0.28s) var(--ease-out-quart, ease);
  }

  /* Marca de acento que se despliega a la izquierda */
  .dropdown__link::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 3px;
    height: 0;
    background: var(--color-accent);
    border-radius: 0 2px 2px 0;
    transform: translateY(-50%);
    transition: height var(--dur-2, 0.28s) var(--ease-out-back, ease);
  }

  .dropdown__link:hover,
  .dropdown__link.active {
    background-color: var(--color-surface-muted);
    color: var(--color-brand-primary);
    padding-left: 1.5rem;
  }

  .dropdown__link:hover::before,
  .dropdown__link.active::before {
    height: 60%;
  }

  /* ── CTA nav ── */
  .nav-cta {
    padding: 0.5rem 1.25rem;
    font-size: var(--text-sm);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── Hamburguesa (mobile) ── */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .hamburger__line {
    display: block;
    width: 24px;
    height: 2px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 2px;
    transform-origin: center;
    transition:
      transform var(--dur-3, 0.45s) var(--ease-out-back, ease),
      opacity var(--dur-1, 0.16s) var(--ease-out-quart, ease),
      background-color var(--dur-2, 0.28s) var(--ease-out-quart, ease);
  }

  /* Solo con puntero real: en táctil el :hover se queda "pegado" tras el tap */
  @media (hover: hover) {
    .hamburger:hover .hamburger__line {
      background: var(--color-accent);
    }
  }

  /* Hamburger state: open */
  .hamburger[aria-expanded="true"] .hamburger__line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] .hamburger__line:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded="true"] .hamburger__line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Menú móvil ── */
  .mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    background: var(--color-brand-secondary);
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows var(--dur-3, 0.45s) var(--ease-out-expo, ease),
      opacity var(--dur-2, 0.28s) var(--ease-out-quart, ease),
      visibility 0s linear var(--dur-3, 0.45s);
  }

  .mobile-menu > :global(.container) {
    overflow: hidden;
    min-height: 0;
  }

  .mobile-menu[aria-hidden="false"] {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    transition-delay: 0s;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0;
  }

  /* Los enlaces caen escalonados al abrir */
  .mobile-nav-list > li {
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--dur-2, 0.28s) var(--ease-out-quart, ease),
      transform var(--dur-3, 0.45s) var(--ease-out-expo, ease);
  }

  .mobile-menu[aria-hidden="false"] .mobile-nav-list > li {
    opacity: 1;
    transform: none;
  }

  .mobile-menu[aria-hidden="false"] .mobile-nav-list > li:nth-child(1) {
    transition-delay: 80ms;
  }

  .mobile-menu[aria-hidden="false"] .mobile-nav-list > li:nth-child(2) {
    transition-delay: 130ms;
  }

  .mobile-menu[aria-hidden="false"] .mobile-nav-list > li:nth-child(3) {
    transition-delay: 180ms;
  }

  .mobile-menu[aria-hidden="false"] .mobile-nav-list > li:nth-child(4) {
    transition-delay: 230ms;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 0;
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-heading);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: color var(--transition-base);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--color-accent);
    transform: translateX(4px);
  }

  .mobile-nav-link {
    transition:
      color var(--dur-2, 0.28s) var(--ease-out-quart, ease),
      transform var(--dur-2, 0.28s) var(--ease-out-quart, ease);
  }

  .mobile-nav__footer {
    padding-bottom: 1.5rem;
  }

  .mobile-sub-list {
    list-style: none;
    padding: 0 0 0 1rem;
    margin: 0;
  }

  .mobile-sub-link {
    display: block;
    padding: 0.5rem 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .mobile-sub-link:hover {
    color: var(--color-accent);
  }

  .mobile-cta {
    margin-top: 1rem;
    width: 100%;
    justify-content: center;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .nav-list,
    .nav-cta {
      display: none;
    }

    .hamburger {
      display: flex;
    }
  }
</style>

<script>
  // Menú hamburguesa — se re-enlaza en cada navegación porque el DOM
  // se reemplaza al usar View Transitions.
  function setMenuOpen(open: boolean) {
    const btn = document.getElementById("hamburger-btn");
    const menu = document.getElementById("mobile-menu");
    if (!btn || !menu) return;
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    menu.setAttribute("aria-hidden", String(!open));
  }

  function initHeader() {
    const btn = document.getElementById("hamburger-btn");
    if (!btn || btn.dataset.bound === "1") return;
    btn.dataset.bound = "1";

    btn.addEventListener("click", () => {
      setMenuOpen(btn.getAttribute("aria-expanded") !== "true");
    });
  }

  // Listeners globales: una sola vez por sesión (sobreviven a la navegación)
  document.addEventListener("keydown", (e) => {
    const btn = document.getElementById("hamburger-btn");
    if (e.key === "Escape" && btn?.getAttribute("aria-expanded") === "true") {
      setMenuOpen(false);
      btn.focus();
    }
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth > 900) setMenuOpen(false);
  });

  document.addEventListener("astro:page-load", initHeader);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeader, { once: true });
  } else {
    initHeader();
  }
</script>
