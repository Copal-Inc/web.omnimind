---
import { SITE_TITLE } from "../consts";

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const pathname = Astro.url.pathname;

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
  { href: `${base}/`, label: "Inicio" },
  { href: `${base}/sobre-nosotros/`, label: "Sobre Omnimind" },
  {
    href: `${base}/servicios/`,
    label: "Soluciones",
    children: [
      { href: `${base}/servicios/empowermind/`, label: "Empowermind" },
      { href: `${base}/servicios/wealth-mind/`, label: "Wealth & Mind" },
      { href: `${base}/servicios/neurowise/`, label: "Neurowise" },
    ],
  },
  { href: `${base}/blog/`, label: "Blog" },
];

function isActive(href: string): boolean {
  // El enlace de inicio necesita coincidir exactamente para no marcarse en todas las páginas
  if (href === "/" || href === `${base}/`) {
    return pathname === href || pathname === base;
  }
  return pathname.startsWith(href);
}
---

<header
  class={`site-header${transparent ? " site-header--transparent" : ""}`}
  id="site-header"
>
  <!-- Barra superior: Logo -->
  <div class="header-top">
    <div class="container">
      <a href={`${base}/`} class="logo" aria-label="Omnimind — Inicio">
        <div class="logo__icon" aria-hidden="true">
          <img
            src={`${base}/img/icononly_transparent_nobuffer.png`}
            alt=""
            width="56"
            height="56"
            class="logo__img"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="logo__text">
          <span class="logo__name">{SITE_TITLE}</span>
          <span class="logo__tagline">A healthy mind is a prosper mind</span>
        </div>
      </a>
    </div>
  </div>

  <!-- Barra de navegación principal -->
  <nav class="header-nav" aria-label="Navegación principal">
    <div class="container header-nav__inner">
      <!-- Links de navegación -->
      <ul class="nav-list" role="list">
        {
          navLinks.map((link) => (
            <li class={`nav-item${link.children ? " nav-item--dropdown" : ""}`}>
              {link.children ? (
                <>
                  <button
                    class={`nav-link nav-link--btn${isActive(link.href) ? " active" : ""}`}
                    aria-expanded="false"
                    aria-haspopup="true"
                    id={`dropdown-${link.label.toLowerCase().replace(/\s+/g, "-")}`}
                  >
                    {link.label}
                    <svg
                      class="nav-chevron"
                      width="14"
                      height="14"
                      viewBox="0 0 14 14"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M3 5L7 9L11 5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>
                  <ul
                    class="dropdown"
                    role="list"
                    aria-label={`Submenu ${link.label}`}
                  >
                    {link.children.map((child) => (
                      <li class="dropdown__item">
                        <a
                          href={child.href}
                          class={`dropdown__link${isActive(child.href) ? " active" : ""}`}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  href={link.href}
                  class={`nav-link${isActive(link.href) ? " active" : ""}`}
                >
                  {link.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <!-- CTA principal -->
      <div class="header-cta">
        <a href={`${base}/contacto/`} class="btn btn-accent nav-cta">
          Solicitar cotización
        </a>
      </div>

      <!-- Botón hamburguesa (mobile) -->
      <button
        class="hamburger"
        id="hamburger-btn"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span class="hamburger__line"></span>
        <span class="hamburger__line"></span>
        <span class="hamburger__line"></span>
      </button>
    </div>

    <!-- Menú móvil -->
    <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
      <div class="container">
        <ul class="mobile-nav-list" role="list">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class={`mobile-nav-link${isActive(link.href) ? " active" : ""}`}
                >
                  {link.label}
                </a>
                {link.children && (
                  <ul class="mobile-sub-list" role="list">
                    {link.children.map((child) => (
                      <li>
                        <a href={child.href} class="mobile-sub-link">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
        <div class="mobile-nav__footer">
          <a href={`${base}/contacto/`} class="btn btn-primary mobile-cta">
            Solicitar cotización
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  /* ── Header ── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  /* ── Barra superior con logo ── */
  .header-top {
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-border);
    background: #f1f4f4;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    text-decoration: none;
    color: inherit;
  }

  .logo__icon {
    flex-shrink: 0;
    line-height: 1;
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .logo__name {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 800;
    letter-spacing: 0.25em;
    color: var(--color-brand-primary);
    line-height: 1;
  }

  .logo__img {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  .logo__tagline {
    font-family: var(--font-body);
    font-size: var(--text-s);
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    font-style: italic;
    line-height: 1;
  }

  /* ── Barra de navegación ── */
  .header-nav {
    background: var(--color-brand-secondary);
    position: relative;
  }

  .header-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 52px;
  }

  /* ── Nav list ── */
  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    color: rgba(255, 255, 255, 0.88);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-bottom: 3px solid transparent;
    transition:
      color var(--transition-base),
      border-color var(--transition-base),
      background-color var(--transition-base);
    white-space: nowrap;
  }

  .nav-link--btn {
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
    padding: 0.9rem 1rem;
  }

  .nav-link:hover,
  .nav-link--btn:hover,
  .nav-link.active,
  .nav-link--btn.active {
    color: #ffffff;
    border-bottom-color: var(--color-accent);
  }

  .nav-chevron {
    transition: transform var(--transition-base);
  }

  /* ── Dropdown ── */
  .nav-item--dropdown {
    position: relative;
  }

  .dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background: var(--color-surface);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    box-shadow: var(--shadow-lg);
    list-style: none;
    padding: 0.5rem 0;
    margin: 0;
    border-top: 3px solid var(--color-accent);
    z-index: 200;
  }

  .nav-item--dropdown:hover .dropdown,
  .nav-item--dropdown:focus-within .dropdown {
    display: block;
  }

  .nav-item--dropdown:hover .nav-chevron,
  .nav-item--dropdown:focus-within .nav-chevron {
    transform: rotate(180deg);
  }

  .dropdown__link {
    display: block;
    padding: 0.6rem 1.25rem;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-family: var(--font-heading);
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--transition-base),
      color var(--transition-base);
  }

  .dropdown__link:hover,
  .dropdown__link.active {
    background-color: var(--color-surface-muted);
    color: var(--color-brand-primary);
  }

  /* ── CTA nav ── */
  .nav-cta {
    padding: 0.5rem 1.25rem;
    font-size: var(--text-sm);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── Hamburguesa (mobile) ── */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .hamburger__line {
    display: block;
    width: 24px;
    height: 2px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 2px;
    transition:
      transform var(--transition-base),
      opacity var(--transition-base);
  }

  /* Hamburger state: open */
  .hamburger[aria-expanded="true"] .hamburger__line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] .hamburger__line:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded="true"] .hamburger__line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Menú móvil ── */
  .mobile-menu {
    display: none;
    background: var(--color-brand-secondary);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 1.5rem;
  }

  .mobile-menu[aria-hidden="false"] {
    display: block;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 0;
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-heading);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: color var(--transition-base);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--color-accent);
  }

  .mobile-sub-list {
    list-style: none;
    padding: 0 0 0 1rem;
    margin: 0;
  }

  .mobile-sub-link {
    display: block;
    padding: 0.5rem 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .mobile-sub-link:hover {
    color: var(--color-accent);
  }

  .mobile-cta {
    margin-top: 1rem;
    width: 100%;
    justify-content: center;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .nav-list,
    .nav-cta {
      display: none;
    }

    .hamburger {
      display: flex;
    }
  }
</style>

<script>
  // Menú hamburguesa (CSS puro + JS mínimo para accesibilidad)
  const btn = document.getElementById("hamburger-btn");
  const menu = document.getElementById("mobile-menu");

  if (btn && menu) {
    btn.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!isOpen));
      menu.setAttribute("aria-hidden", String(isOpen));
    });
  }

  // Cerrar menú al cambiar de tamaño a desktop
  window.addEventListener("resize", () => {
    if (window.innerWidth > 900 && btn && menu) {
      btn.setAttribute("aria-expanded", "false");
      menu.setAttribute("aria-hidden", "true");
    }
  });
</script>
