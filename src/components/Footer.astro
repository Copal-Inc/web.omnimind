---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');

const solutions = [
  { href: `${base}/servicios/empowermind/`, label: 'Empowermind' },
  { href: `${base}/servicios/wealth-mind/`, label: 'Wealth & Mind' },
  { href: `${base}/servicios/neurowise/`, label: 'Neurowise' },
];

const company = [
  { href: `${base}/sobre-nosotras/`, label: 'Sobre Omnimind' },
  { href: `${base}/blog/`, label: 'Blog' },
  { href: `${base}/contacto/`, label: 'Contacto' },
  { href: `${base}/aviso-de-privacidad/`, label: 'Aviso de privacidad' },
];
---

<footer class="site-footer">
  <div class="container footer__grid">

    <!-- Columna 1: Logo + tagline + redes -->
    <div class="footer__brand">
      <a href={`${base}/`} class="footer__logo" aria-label="Omnimind — Inicio">
        <div class="footer__logo-icon" aria-hidden="true">
          <img src={`${base}/img/icononly_transparent_nobuffer.png`} alt="" width="48" height="48" loading="lazy" />
        </div>
        <img
          src={`${base}/img/fulllogo_transparent.png`}
          alt="Omnimind — A healthy mind is a prosper mind"
          width="180"
          height="90"
          class="footer__logo-img"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="footer__tagline">A healthy mind is a prosper mind</p>
      <p class="footer__description">
        Workshops e intervenciones organizacionales basadas en evidencia, para equipos y organizaciones que buscan crecer.
      </p>

      <!-- Redes sociales -->
      <div class="footer__social">
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="footer__social-link"
          aria-label="Omnimind en Instagram"
        >
          <!-- Instagram icon -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
            <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2"/>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
          </svg>
        </a>
        <a
          href="https://linkedin.com"
          target="_blank"
          rel="noopener noreferrer"
          class="footer__social-link"
          aria-label="Omnimind en LinkedIn"
        >
          <!-- LinkedIn icon -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="4" stroke="currentColor" stroke-width="2"/>
            <path d="M7 10v7M7 7v.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M11 17v-3.5a2.5 2.5 0 0 1 5 0V17M11 10v7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Columna 2: Soluciones -->
    <nav class="footer__nav" aria-label="Soluciones">
      <h3 class="footer__nav-title">Soluciones</h3>
      <ul class="footer__nav-list" role="list">
        {solutions.map((link) => (
          <li>
            <a href={link.href} class="footer__nav-link">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Columna 3: Empresa -->
    <nav class="footer__nav" aria-label="Empresa">
      <h3 class="footer__nav-title">Empresa</h3>
      <ul class="footer__nav-list" role="list">
        {company.map((link) => (
          <li>
            <a href={link.href} class="footer__nav-link">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Columna 4: Contacto -->
    <div class="footer__contact">
      <h3 class="footer__nav-title">Contacto</h3>
      <p class="footer__contact-item">
        <a href="mailto:info@omnimindcourses.com" class="footer__nav-link">
          info@omnimindcourses.com
        </a>
      </p>
      <div class="footer__cta">
        <a href="/contacto/" class="btn btn-accent footer__cta-btn">
          Solicitar cotización
        </a>
      </div>
    </div>

  </div>

  <!-- Barra inferior -->
  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p class="footer__copyright">
        © {year} Omnimind. Todos los derechos reservados.
      </p>
      <p class="footer__credit">
        <!-- Crédito Copal Inc — placeholder hasta confirmar identidad -->
        Desarrollado por <a href="#" class="footer__nav-link">Copal Inc</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-brand-secondary);
    color: var(--color-text-on-dark);
    padding-top: 4rem;
  }

  /* ── Grid principal ── */
  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  /* ── Brand / Logo ── */
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .footer__logo-img {
    display: block;
    width: 160px;
    height: auto;
    /* El logo PNG tiene fondo transparente; sobre el fondo oscuro del footer se ve perfecto */
    filter: brightness(0) invert(1);  /* convierte a blanco para el fondo indigo */
    opacity: 0.92;
    transition: opacity var(--transition-base);
  }

  .footer__logo:hover .footer__logo-img {
    opacity: 1;
  }

  .footer__tagline {
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-text-on-dark-soft);
    margin: 0;
  }

  .footer__description {
    font-size: var(--text-sm);
    color: var(--color-text-on-dark-soft);
    line-height: 1.6;
    max-width: 280px;
    margin: 0;
  }

  /* ── Redes sociales ── */
  .footer__social {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-pill);
    color: var(--color-text-on-dark);
    text-decoration: none;
    transition:
      background-color var(--transition-base),
      color var(--transition-base);
  }

  .footer__social-link:hover {
    background: var(--color-accent);
    color: #fff;
  }

  /* ── Nav columnas ── */
  .footer__nav-title {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 1.25rem 0;
  }

  .footer__nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__nav-link {
    color: var(--color-text-on-dark-soft);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .footer__nav-link:hover {
    color: var(--color-text-on-dark);
  }

  /* ── Contacto ── */
  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__contact-item {
    margin: 0;
  }

  .footer__cta {
    margin-top: 1rem;
  }

  .footer__cta-btn {
    font-size: var(--text-sm);
    padding: 0.625rem 1.25rem;
  }

  /* ── Barra inferior ── */
  .footer__bottom {
    background: rgba(0, 0, 0, 0.2);
    padding-block: 1.25rem;
  }

  .footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer__copyright,
  .footer__credit {
    font-size: var(--text-sm);
    color: var(--color-text-on-dark-soft);
    margin: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer__bottom-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
